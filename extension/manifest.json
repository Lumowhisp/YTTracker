{
  "manifest_version": 3,
  "name": "Activity Tracker",
  "version": "3.0",
  "description": "Complete digital wellbeing tracker: YouTube watch time, full web activity monitoring, productivity insights, and ML-powered classification.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Activity Tracker"
  }
}
